  "queries": [
    {
      "id": "4fa96899-4a81-40f5-80ad-81874f7cfb39",
      "text": "TripActivities | where EventTimestampUtc between (datetime(2026-06-01) .. datetime(2026-09-01)) | where ActivityType == \"Pickup\" | summarize Trips=count() by bin(EventTimestampUtc, 1h) | order by EventTimestampUtc asc",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "14d82db0-135f-4ee9-8528-9fb72d324d06"
      }
    },
    {
      "id": "2a8b3c24-5827-47b2-9720-94db92ba5cc7",
      "text": "TripActivities | where EventTimestampUtc between (datetime(2026-06-01) .. datetime(2026-09-01)) | where ActivityType == \"Pickup\" | join kind=leftouter Locations on LocationId | summarize Pickups=count() by PlanningArea | top 10 by Pickups desc",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "14d82db0-135f-4ee9-8528-9fb72d324d06"
      }
    },
    {
      "id": "84f37989-1cc5-4849-a500-a83208ebdc32",
      "text": "let Pickups = TripActivities | where EventTimestampUtc between (datetime(2026-06-01) .. datetime(2026-09-01)) and ActivityType == \"Pickup\" | project TripId, PickupLocationId=LocationId; let Dropoffs = TripActivities | where EventTimestampUtc between (datetime(2026-06-01) .. datetime(2026-09-01)) and ActivityType == \"Dropoff\" | project TripId, DropoffLocationId=LocationId; Pickups | join kind=inner Dropoffs on TripId | summarize Trips=count() by PickupLocationId, DropoffLocationId | top 20 by Trips desc",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "14d82db0-135f-4ee9-8528-9fb72d324d06"
      }
    },
    {
      "id": "3e8d6c7c-9756-45d4-8de0-8837e18efda5",
      "text": "TripActivities | where EventTimestampUtc between (datetime(2026-06-01) .. datetime(2026-09-01)) | summarize PickupTime=minif(EventTimestampUtc, ActivityType == \"Pickup\"), DropoffTime=maxif(EventTimestampUtc, ActivityType == \"Dropoff\") by TripId | extend DurationMinutes=datetime_diff(\"minute\", DropoffTime, PickupTime) | summarize Trips=count(), P50Minutes=percentile(DurationMinutes, 50), P95Minutes=percentile(DurationMinutes, 95)",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "14d82db0-135f-4ee9-8528-9fb72d324d06"
      }
    },
    {
      "id": "0744337b-fed0-469e-8682-b78fba8cf82f",
      "text": "TripActivities | where EventTimestampUtc between (datetime(2026-06-01) .. datetime(2026-09-01)) | summarize arg_max(EventTimestampUtc, *) by Vin | project EventTimestampUtc, Vin, ActivityType, Latitude, Longitude",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "14d82db0-135f-4ee9-8528-9fb72d324d06"
      }
    }
  ],
