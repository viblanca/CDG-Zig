// KQL script
// Use management commands in this script to configure your database items, such as tables, functions, materialized views, and more.


.create-merge table TripActivities (EventId:string, TripId:string, EventTimestampUtc:datetime, EventTimestampSgt:datetime, Vin:string, CustomerId:string, ActivityType:string, LocationId:string, Latitude:real, Longitude:real) 
.create-merge table Vehicles (Vin:string, FleetVehicleId:string, VehicleMake:string, VehicleModel:string, ModelYear:int, VehicleClass:string, Powertrain:string, SeatingCapacity:int, AccessibilityEnabled:bool, FleetStatus:string) 
.create-merge table Customers (CustomerId:string, CustomerSegment:string, LoyaltyTier:string, MemberSince:datetime, PreferredBookingChannel:string, HomeRegion:string, MarketingConsent:bool) 
.create-merge table AppDownloads (DownloadId:string, CustomerId:string, DeviceId:string, SyntheticPhoneNumber:string, DownloadDateUtc:datetime, Platform:string, AppVersion:string, AcquisitionChannel:string) 
.create-merge table Locations (LocationId:string, LocationName:string, LocationType:string, PlanningArea:string, Region:string, CountryCode:string, Latitude:real, Longitude:real) 
.create-merge table ActivityTypes (ActivityType:string, ActivityGroup:string, LifecycleSequence:int, Description:string) 
.alter table TripActivities policy retention @'{"SoftDeletePeriod":"365.00:00:00","Recoverability":"Enabled"}'
.alter table TripActivities policy caching hotdata = time(90.00:00:00) hotindex = time(90.00:00:00)
