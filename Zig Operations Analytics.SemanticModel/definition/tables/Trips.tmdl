/// One row per completed synthetic Zig trip, paired from Pickup and Dropoff events.
table Trips

	measure Trips = COUNTROWS('Trips')
		formatString: #,##0
		displayFolder: Volume

	measure Pickups = COUNTROWS('Trips')
		formatString: #,##0
		displayFolder: Volume

	measure 'Active Customers' = DISTINCTCOUNT('Trips'[Customer ID])
		formatString: #,##0
		displayFolder: Customers

	measure 'Active Vehicles' = DISTINCTCOUNT('Trips'[VIN])
		formatString: #,##0
		displayFolder: Fleet

	measure 'Average Trip Duration' = AVERAGE('Trips'[Duration Minutes])
		formatString: #,##0.0 "min"
		displayFolder: Duration

	measure 'Median Trip Duration' = MEDIAN('Trips'[Duration Minutes])
		formatString: #,##0.0 "min"
		displayFolder: Duration

	measure 'P95 Trip Duration' = PERCENTILE.INC('Trips'[Duration Minutes], 0.95)
		formatString: #,##0.0 "min"
		displayFolder: Duration

	measure 'Trips per Active Vehicle' = DIVIDE([Trips], [Active Vehicles])
		formatString: #,##0.0
		displayFolder: Fleet

	column 'Trip ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: trip_id

	column VIN
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: vin

	column 'Customer ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: customer_id

	column 'Trip Date'
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: trip_date

	column 'Singapore Hour'
		dataType: int64
		formatString: 00
		summarizeBy: none
		sourceColumn: singapore_hour

	column 'Pickup Time SGT'
		dataType: dateTime
		formatString: dd mmm yyyy HH:mm
		summarizeBy: none
		sourceColumn: pickup_timestamp_sgt

	column 'Dropoff Time SGT'
		dataType: dateTime
		formatString: dd mmm yyyy HH:mm
		summarizeBy: none
		sourceColumn: dropoff_timestamp_sgt

	column 'Duration Minutes'
		dataType: decimal
		isHidden
		formatString: #,##0.0
		summarizeBy: none
		sourceColumn: duration_minutes

	column Origin
		dataType: string
		summarizeBy: none
		sourceColumn: origin_name

	column Destination
		dataType: string
		summarizeBy: none
		sourceColumn: destination_name

	column 'Origin Planning Area'
		dataType: string
		summarizeBy: none
		sourceColumn: origin_planning_area

	column 'Destination Planning Area'
		dataType: string
		summarizeBy: none
		sourceColumn: destination_planning_area

	column 'Origin Region'
		dataType: string
		summarizeBy: none
		sourceColumn: origin_region

	column 'Destination Region'
		dataType: string
		summarizeBy: none
		sourceColumn: destination_region

	column 'Origin-Destination Pair'
		dataType: string
		summarizeBy: none
		sourceColumn: origin_destination_pair

	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: trip_status

	partition Trips = entity
		mode: directLake
		source
			entityName: fact_trips
			schemaName: gold
			expressionSource: 'DirectLake - Zig Operations Analytics'

